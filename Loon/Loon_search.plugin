#!name=Search
#!desc=Safari / DuckDuckGo 自用搜索快捷指令

[Rewrite]
# wk xxx - Wikipedia 中文
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=wk(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://zh.wikipedia.org/wiki/$1

# bd xxx - 百度
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=bd(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.baidu.com/s?wd=$1

# gh xxx - GitHub
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=gh(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://github.com/search?q=$1

# gu xxx - GitHub User
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=gu(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://github.com/search?q=$1&type=users

# gi xxx - Google 图片
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=gi(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.google.com/search?tbm=isch&q=$1

# ph xxx - PornHub
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=ph(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://cn.pornhub.com/video/search?search=$1

# gd xxx - Google Drive 资源搜索
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=gd(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.google.com/search?q=%22Google+Drive%22+$1

# 普通搜索默认 Google；排除所有上面的快捷指令
^https:\/\/(?:www\.)?duckduckgo\.com\/\?q=(?!(?:wk|bd|gh|gu|gi|ph|gd)(?:\+|%20))([^&]+)(?:&.*)?$ 302 https://www.google.com/search?q=$1&num=100

[MITM]
hostname = duckduckgo.com, www.duckduckgo.com
