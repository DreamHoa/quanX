#!name=Search
#!desc=自用搜索快捷指令

[Rewrite]
# wk xxx - Wikipedia 中文
^https:\/\/duckduckgo\.com\/\?q=wk(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://zh.wikipedia.org/wiki/$1

# bd xxx - 百度
^https:\/\/duckduckgo\.com\/\?q=bd(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.baidu.com/s?wd=$1

# gh xxx - GitHub
^https:\/\/duckduckgo\.com\/\?q=gh(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://github.com/search?q=$1

# gu xxx - GitHub User
^https:\/\/duckduckgo\.com\/\?q=gu(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://github.com/search?q=$1&type=users

# gi xxx - Google 图片
^https:\/\/duckduckgo\.com\/\?q=gi(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.google.com/search?tbm=isch&q=$1

# ph xxx - PornHub
^https:\/\/duckduckgo\.com\/\?q=ph(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://cn.pornhub.com/video/search?search=$1

# gd xxx - Google Drive 资源搜索
^https:\/\/duckduckgo\.com\/\?q=gd(?:\+|%20)([^&]+)(?:&.*)?$ 302 https://www.google.com/search?q=%22Google+Drive%22+$1

# 默认使用 Google
^https:\/\/duckduckgo\.com\/\?q=([^&]+)(?:&.*)?$ 302 https://www.google.com/search?q=$1&num=100

[MITM]
hostname = duckduckgo.com
